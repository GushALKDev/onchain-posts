  "cards": [
    {
      "dot": "emerald",
      "title": "Publish path",
      "items": [
        "Browser normalises, strips EXIF/XMP and signs EIP-712 over the final bytes",
        "API validates and returns a signed receipt (Accepted) with one anchorBy per chain",
        "Storage worker uploads image, then post JSON, with the platform Arweave key",
        "Only stored posts enter a chain queue; all workers claim jobs from Postgres"
      ]
    },
    {
      "dot": "cyan",
      "title": "Anchoring",
      "items": [
        "One queue per chain; flush at Nmax (default 500) or Tmax (defaults: 30 s on L2s, 300 s on Ethereum, tunable)",
        "One tx per batch and chain anchors a Merkle root; nothing per post on-chain",
        "Batch identity is (chainId, sender, root); the relayer sends every tx",
        "Tracker polls soft and safe heads on all 3 chains and updates proof bundles"
      ]
    },
    {
      "dot": "violet",
      "title": "Verification",
      "items": [
        "Verifier uses only an Arweave gateway, public RPCs and config/trusted-keys.json",
        "GET /proof/:postHash hints from the API are untrusted and re-checked",
        "The web Verify page imports the same library: a convenience, not the independent path"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy",
      "items": [
        "The user address and signature appear nowhere on-chain or on Arweave",
        "Openfort knows email and address; whether it sees intents: To verify",
        "Postgres stores HMAC(address) and signatures encrypted with an external key"
      ]
    }
  ]
