{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Data model: signed content, receipts, commitments and trust root",
    "locale": "en",
    "output": "docs/diagrams/html/05-data-model.html",
    "quality_profile": "showcase"
  },
  "layout": {
    "mode": "grid",
    "gapX": 80,
    "gapY": 48,
    "entityW": 270
  },
  "entities": [
    {
      "id": "PublishIntent",
      "label": "PublishIntent",
      "sublabel": "EIP-712, signed by the user",
      "tag": "user-signed",
      "row": 0,
      "col": 0,
      "attributes": [
        {
          "name": "nonce",
          "type": "bytes32 (random)",
          "key": "pk"
        },
        {
          "name": "post",
          "type": "Post (embedded)",
          "key": "fk",
          "references": "Post.postHash"
        },
        {
          "name": "chainIds",
          "type": "uint256[] (1 to 3)"
        },
        {
          "name": "deadline",
          "type": "uint64"
        },
        {
          "name": "signature",
          "type": "bytes (private)"
        }
      ]
    },
    {
      "id": "Post",
      "label": "Post",
      "sublabel": "same content on every chain",
      "tag": "user-signed",
      "row": 0,
      "col": 1,
      "attributes": [
        {
          "name": "postHash",
          "type": "bytes32 (hashStruct)",
          "key": "pk"
        },
        {
          "name": "username",
          "type": "string (NFC)"
        },
        {
          "name": "contentType",
          "type": "string (\"post\")"
        },
        {
          "name": "caption",
          "type": "string (max 1000)"
        },
        {
          "name": "imageHash",
          "type": "bytes32 or 0x0"
        },
        {
          "name": "createdAt",
          "type": "uint64 (untrusted)"
        }
      ]
    },
    {
      "id": "Leaf",
      "label": "Leaf",
      "sublabel": "one per post per batch",
      "tag": "Arweave",
      "row": 0,
      "col": 2,
      "attributes": [
        {
          "name": "leafHash",
          "type": "bytes32 (2x keccak)",
          "key": "pk"
        },
        {
          "name": "postHash",
          "type": "bytes32",
          "key": "fk",
          "references": "Post.postHash"
        },
        {
          "name": "postArweaveId",
          "type": "bytes32"
        },
        {
          "name": "sigCommit",
          "type": "keccak256(sig)"
        },
        {
          "name": "manifestId",
          "type": "Arweave ID",
          "key": "fk",
          "references": "Manifest.manifestId"
        }
      ]
    },
    {
      "id": "Manifest",
      "label": "Manifest",
      "sublabel": "phi.manifest/1, one per batch and chain",
      "tag": "Arweave",
      "row": 0,
      "col": 3,
      "attributes": [
        {
          "name": "manifestId",
          "type": "Arweave ID",
          "key": "pk"
        },
        {
          "name": "chainId",
          "type": "uint256",
          "key": "uk"
        },
        {
          "name": "root",
          "type": "bytes32",
          "key": "uk"
        },
        {
          "name": "leafEncoding",
          "type": "bytes32 x 3"
        },
        {
          "name": "leaves",
          "type": "Leaf[] (sorted)"
        }
      ]
    },
    {
      "id": "Receipt",
      "label": "Receipt",
      "sublabel": "EIP-712 domain Phi Receipts",
      "tag": "platform-signed",
      "row": 1,
      "col": 0,
      "attributes": [
        {
          "name": "postHash",
          "type": "bytes32",
          "key": [
            "pk",
            "fk"
          ],
          "references": "Post.postHash"
        },
        {
          "name": "sigCommit",
          "type": "bytes32"
        },
        {
          "name": "acceptedAt",
          "type": "uint64 (signer-set)"
        },
        {
          "name": "deadlines",
          "type": "Deadline[]"
        },
        {
          "name": "signer",
          "type": "address",
          "key": "fk",
          "references": "TrustedKey.address"
        }
      ]
    },
    {
      "id": "ProofBundle",
      "label": "ProofBundle",
      "sublabel": "phi.proof/1, untrusted hints",
      "tag": "hints",
      "row": 1,
      "col": 1,
      "attributes": [
        {
          "name": "postHash",
          "type": "bytes32",
          "key": [
            "pk",
            "fk"
          ],
          "references": "Post.postHash"
        },
        {
          "name": "postArweaveId",
          "type": "Arweave ID"
        },
        {
          "name": "imageArweaveId",
          "type": "Arweave ID"
        },
        {
          "name": "anchors",
          "type": "Anchor[] (+ proof)"
        },
        {
          "name": "pending",
          "type": "{chainId, anchorBy}[]"
        },
        {
          "name": "receipt",
          "type": "Receipt",
          "key": "fk",
          "references": "Receipt.postHash"
        },
        {
          "name": "signature",
          "type": "bytes (private)"
        },
        {
          "name": "intent",
          "type": "intent fields (private)"
        }
      ]
    },
    {
      "id": "Batch",
      "label": "Batch",
      "sublabel": "PostAnchor record + event",
      "tag": "on-chain",
      "row": 1,
      "col": 3,
      "attributes": [
        {
          "name": "chainId",
          "type": "uint256",
          "key": "pk"
        },
        {
          "name": "sender",
          "type": "address",
          "key": [
            "pk",
            "fk"
          ],
          "references": "TrustedKey.address"
        },
        {
          "name": "root",
          "type": "bytes32",
          "key": "pk"
        },
        {
          "name": "anchoredAt",
          "type": "uint256 (timestamp)"
        },
        {
          "name": "manifestId",
          "type": "bytes32 (event)",
          "key": "fk",
          "references": "Manifest.manifestId"
        },
        {
          "name": "count",
          "type": "uint32 (event)"
        }
      ]
    },
    {
      "id": "Deadline",
      "label": "Deadline",
      "sublabel": "one per selected chain",
      "tag": "platform-signed",
      "row": 2,
      "col": 0,
      "attributes": [
        {
          "name": "postHash",
          "type": "bytes32",
          "key": [
            "pk",
            "fk"
          ],
          "references": "Receipt.postHash"
        },
        {
          "name": "chainId",
          "type": "uint256",
          "key": "pk"
        },
        {
          "name": "anchorBy",
          "type": "uint64 (Published)"
