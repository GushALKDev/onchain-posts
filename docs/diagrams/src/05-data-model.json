      ]
    },
    {
      "id": "TrustedKey",
      "label": "TrustedKey",
      "sublabel": "config/trusted-keys.json",
      "tag": "trust root",
      "row": 2,
      "col": 2,
      "attributes": [
        {
          "name": "address",
          "type": "address",
          "key": "pk"
        },
        {
          "name": "role",
          "type": "relayer | receipt"
        },
        {
          "name": "chainId",
          "type": "uint256 | null"
        },
        {
          "name": "validFrom",
          "type": "ISO 8601 UTC"
        },
        {
          "name": "revokedAt",
          "type": "ISO 8601 UTC | null"
        },
        {
          "name": "note",
          "type": "string"
        }
      ]
    }
  ],
  "relationships": [
    {
      "id": "intent-post",
      "from": "PublishIntent",
      "to": "Post",
      "label": "wraps",
      "fromCardinality": "one",
      "toCardinality": "one"
    },
    {
      "id": "leaf-post",
      "from": "Leaf",
      "to": "Post",
      "label": "commits to",
      "fromCardinality": "many",
      "toCardinality": "one"
    },
    {
      "id": "leaf-manifest",
      "from": "Leaf",
      "to": "Manifest",
      "label": "listed in",
      "fromCardinality": "many",
      "toCardinality": "one"
    },
    {
      "id": "batch-manifest",
      "from": "Batch",
      "to": "Manifest",
      "label": "event manifestId",
      "fromCardinality": "one",
      "toCardinality": "one"
    },
    {
      "id": "receipt-post",
      "from": "Receipt",
      "to": "Post",
      "label": "acknowledges",
      "fromCardinality": "one",
      "toCardinality": "one"
    },
    {
      "id": "deadline-receipt",
      "from": "Deadline",
      "to": "Receipt",
      "label": "deadlines[]",
      "fromCardinality": "many",
      "toCardinality": "one",
      "identifying": true
    },
    {
      "id": "bundle-post",
      "from": "ProofBundle",
      "to": "Post",
      "label": "hints for",
      "fromCardinality": "one",
      "toCardinality": "one"
    },
    {
      "id": "bundle-receipt",
      "from": "ProofBundle",
      "to": "Receipt",
      "label": "embeds",
      "fromCardinality": "one",
      "toCardinality": "one",
      "toOptional": true
    },
    {
      "id": "bundle-batch",
      "from": "ProofBundle",
      "to": "Batch",
      "label": "anchors[]",
      "fromCardinality": "many",
      "toCardinality": "many",
      "toOptional": true
    },
    {
      "id": "receipt-key",
      "from": "Receipt",
      "to": "TrustedKey",
      "label": "signed by receipt key",
      "fromCardinality": "many",
      "toCardinality": "one"
    },
    {
      "id": "batch-key",
      "from": "Batch",
      "to": "TrustedKey",
      "label": "trusted only if relayer",
      "fromCardinality": "many",
      "toCardinality": "one",
      "toOptional": true
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Identity rules",
      "items": [
        "Batch identity is (chainId, sender, root): the leaf has no chainId, so the same root can appear on two chains",
        "Manifest is identified by (chainId, root); it carries no batch number",
        "Only anchoredAt is in contract storage; manifestId and count live in the BatchAnchored event"
      ]
    },
    {
      "dot": "rose",
      "title": "What stays private",
      "items": [
        "The user signature is held by the client (IndexedDB) and encrypted at rest by the backend",
        "Public data carries sigCommit = keccak256(signature) only",
        "ProofBundle.signature and ProofBundle.intent (chainIds, nonce, deadline) exist only in the user's private copy, never in GET /proof"
      ]
    },
    {
      "dot": "amber",
      "title": "Trust",
      "items": [
        "ProofBundle and GET /proof/:postHash are untrusted hints; the verifier re-derives everything",
        "Receipt.acceptedAt is signer-declared: a trusted-keys window check is a consistency check, not a bound on a compromised key",
        "Relayer windows are compared with block.timestamp"
      ]
    }
  ]
}
