{
  "name": "@onchain-posts/web",
  "private": true,
  "version": "0.0.0",
  "description": "Minimal web app (ADR-019): compose, per-chain status, proof bundle download and a Verify page on the verifier library.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @onchain-posts/verifier build && vite",
    "build": "pnpm --filter @onchain-posts/verifier build && tsc -p tsconfig.json && vite build",
    "typecheck": "pnpm --filter @onchain-posts/verifier build && tsc -p tsconfig.json",
    "test": "pnpm --filter @onchain-posts/verifier build && vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@openfort/openfort-js": "2.6.4",
    "@onchain-posts/core": "workspace:*",
    "@onchain-posts/verifier": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
