# Web app configuration (Vite reads it from packages/web/.env). Variable names only.

# Backend API (POST /posts, GET /status, GET /proof, POST /demo/flush)
VITE_API_URL=
# Arweave gateway for the Verify page; with STORAGE_MODE=memory use the backend dev gateway, e.g. http://localhost:8080/dev-gateway
VITE_ARWEAVE_GATEWAY=
# Comma-separated chain IDs offered in the composer: 11155111, 84532, 421614
VITE_CHAINS=
# RPC per chain for the Verify page (defaults: public testnet RPCs)
VITE_RPC_11155111=
VITE_RPC_84532=
VITE_RPC_421614=
# Shows the demo flush button and the demo badge; the token is typed by the operator, never embedded
VITE_DEMO_MODE=
