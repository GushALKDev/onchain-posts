# Variable names only. Never commit values. See ADR-016 for key and secret separation.

# RPC endpoints (testnets used for anchoring, ADR-007)
ETHEREUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Read-only mainnet RPC endpoints, used only by the benchmark for the price snapshot
# and the L2 L1-data-fee oracles (ADR-001). No transaction is ever sent to them.
ETHEREUM_MAINNET_RPC_URL=
BASE_MAINNET_RPC_URL=
ARBITRUM_MAINNET_RPC_URL=

# HTTP port of the backend API
PORT=

# Comma-separated origins allowed to call the API from a browser (the web app), e.g. http://localhost:5173
WEB_ORIGINS=

# Storage: "turbo" (Arweave through Turbo, permanent and public) or "memory" (local runs and tests, lost on restart)
STORAGE_MODE=

# Signer backend: "kms" in production, "simulator" in the PoC (same Signer interface, ADR-016)
SIGNER_MODE=
KMS_SIMULATOR_KEYSTORE_PATH=

# Relayer signer (sends anchor transactions, one entry per key in config/trusted-keys.json)
RELAYER_SIGNER_KEY_REF=

# Receipt signer (signs "Onchain Receipts" EIP-712 receipts, separate from relayer keys, ADR-015)
RECEIPT_SIGNER_KEY_REF=

# Arweave / Turbo data-item signer (platform key, never the user key, ADR-002)
ARWEAVE_SIGNER_KEY_REF=

# Database (Postgres as database and queue, ADR-016)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port for the compose Postgres (default 5432)
POSTGRES_PORT=

# Pseudonymises signer addresses in the DB: HMAC(signerAddress, DB_HMAC_SECRET) (ADR-013)
DB_HMAC_SECRET=

# Reference to the key, held outside the DB, that encrypts stored user signatures (ADR-013)
SIGNATURE_ENCRYPTION_KEY_REF=

# Demo mode: short Tmax and a protected "flush now" endpoint, not the efficiency configuration (ADR-006, ADR-018)
DEMO_MODE=
DEMO_TMAX_SECONDS=
# Shared secret that protects the flush-now endpoint in demo mode
DEMO_FLUSH_TOKEN=

# Per-chain batching overrides (ADR-006). Defaults: Tmax 30 s on the L2s, 300 s on Ethereum Sepolia, Nmax 500 (design parameters)
TMAX_SECONDS_ETHEREUM_SEPOLIA=
TMAX_SECONDS_BASE_SEPOLIA=
TMAX_SECONDS_ARBITRUM_SEPOLIA=
NMAX_ETHEREUM_SEPOLIA=
NMAX_BASE_SEPOLIA=
NMAX_ARBITRUM_SEPOLIA=

# Deployment of PostAnchor on the testnets and funding of the relayer (scripts only, never read by the backend).
# Use a testnet-only key that has never held real funds.
DEPLOYER_PRIVATE_KEY=

# Web app (Vite reads this file from the repository root and exposes only the VITE_* variables to the browser)
VITE_API_URL=
# Comma-separated Arweave gateways, tried in order (default: turbo-gateway.com, ardrive.net, arweave.net);
# with STORAGE_MODE=memory use the backend dev gateway, e.g. http://localhost:8080/dev-gateway
VITE_ARWEAVE_GATEWAYS=
# ar.io GraphQL endpoint used by the post page to show the owner and tags of each upload (default: https://turbo-gateway.com/graphql)
VITE_ARWEAVE_GRAPHQL=
# Comma-separated chain IDs offered in the composer: 11155111, 84532, 421614
VITE_CHAINS=
# RPC per chain for the Verify page (defaults: public testnet RPCs)
VITE_RPC_11155111=
VITE_RPC_84532=
VITE_RPC_421614=
# Shows the demo flush button and the demo badge; the token is typed by the operator, never embedded
VITE_DEMO_MODE=
# Openfort embedded wallet (ADR-011): public keys from the Openfort dashboard; no secret key is needed with password recovery
VITE_OPENFORT_PUBLISHABLE_KEY=
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=
