# Variable names only. Never commit values. See ADR-016 for key and secret separation.

# RPC endpoints (testnets used for anchoring, ADR-007)
ETHEREUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Read-only mainnet RPC endpoints, used only by the benchmark for the price snapshot
# and the L2 L1-data-fee oracles (ADR-001). No transaction is ever sent to them.
ETHEREUM_MAINNET_RPC_URL=
BASE_MAINNET_RPC_URL=
ARBITRUM_MAINNET_RPC_URL=

# Signer backend: "kms" in production, "simulator" in the PoC (same Signer interface, ADR-016)
SIGNER_MODE=
KMS_SIMULATOR_KEYSTORE_PATH=

# Relayer signer (sends anchor transactions, one entry per key in config/trusted-keys.json)
RELAYER_SIGNER_KEY_REF=

# Receipt signer (signs "Phi Receipts" EIP-712 receipts, separate from relayer keys, ADR-015)
RECEIPT_SIGNER_KEY_REF=

# Arweave / Turbo data-item signer (platform key, never the user key, ADR-002)
ARWEAVE_SIGNER_KEY_REF=

# Openfort (embedded account used only as a signing identity, ADR-011; exact key set To verify)
OPENFORT_PUBLISHABLE_KEY=
OPENFORT_SECRET_KEY=

# Database (Postgres as database and queue, ADR-016)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Pseudonymises signer addresses in the DB: HMAC(signerAddress, DB_HMAC_SECRET) (ADR-013)
DB_HMAC_SECRET=

# Reference to the key, held outside the DB, that encrypts stored user signatures (ADR-013)
SIGNATURE_ENCRYPTION_KEY_REF=

# Demo mode: short Tmax and a protected "flush now" endpoint, not the efficiency configuration (ADR-006, ADR-018)
DEMO_MODE=
DEMO_TMAX_SECONDS=
# Shared secret that protects the flush-now endpoint in demo mode
DEMO_FLUSH_TOKEN=

# Per-chain batching overrides (ADR-006). Defaults: Tmax 30 s on the L2s, 300 s on Ethereum Sepolia, Nmax 500 (design parameters)
TMAX_SECONDS_ETHEREUM_SEPOLIA=
TMAX_SECONDS_BASE_SEPOLIA=
TMAX_SECONDS_ARBITRUM_SEPOLIA=
NMAX_ETHEREUM_SEPOLIA=
NMAX_BASE_SEPOLIA=
NMAX_ARBITRUM_SEPOLIA=
